      <SubType>Designer</SubType>
    </Page>
    <Compile Update="Views/Shared/EditorButtonBar.xaml.cs">
      <DependentUpon>EditorButtonBar.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  </Project>

    <Compile Update="Views/Shared/ServiceLogView.xaml.cs">
      <DependentUpon>ServiceLogView.xaml</DependentUpon>
    </Compile>
    <Page Update="Views/Shared/ServiceMessageTableView.xaml">
      <Generator>MSBuild:Compile</Generator>
